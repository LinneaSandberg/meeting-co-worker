# Get your ElevenLabs API key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Get your Anthropic API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===== GitHub Integration (Optional) =====
# Create a personal access token: https://github.com/settings/tokens
# Required scopes: repo (full control)
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO_OWNER=your_github_username
GITHUB_REPO_NAME=your_repo_name

# ===== Google Calendar Integration (Optional) =====
# 1. Create project: https://console.cloud.google.com/
# 2. Enable Google Calendar API
# 3. Create OAuth 2.0 credentials (Desktop app)
# 4. Download credentials.json and specify path below
GOOGLE_OAUTH_CREDENTIALS_PATH=./credentials.json
GOOGLE_CALENDAR_ID=primary

# ===== Integration Settings =====
# Default meeting duration for calendar events (minutes)
DEFAULT_MEETING_DURATION=30

# Default labels for GitHub issues (comma-separated)
GITHUB_DEFAULT_LABELS=meeting-copilot,needs-triage
